{
	"$schema": "https://typedoc.org/schema.json",
	"entryPoints": ["src/index.ts"],
	"tsconfig": "tsconfig.json",
	"out": "docs",
	"name": "GothMommy",
	"readme": "README.md",
	"excludePrivate": true,
	"excludeInternal": true,
	"githubPages": false,
	"treatValidationWarningsAsErrors": true,
	"validation": {
		"notExported": true,
		"invalidLink": true,
		"notDocumented": true
	}
}
