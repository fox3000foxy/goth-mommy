{
	"name": "goth-mommy",
	"version": "0.0.3",
	"license": "MIT",
	"description": "Small zero-dependency genetic algorithm library in TypeScript for hyperparameter search and ordering problems (TSP, scheduling).",
	"repository": {
		"type": "git",
		"url": "https://github.com/fox3000foxy/goth-mommy.git"
	},
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"scripts": {
		"prepack": "npm run build",
		"build:watch": "tsc --watch",
		"typecheck": "tsc --noEmit && tsc --noEmit -p examples",
		"example": "bun examples/basic.ts",
		"examples": "bun examples/basic.ts && bun examples/mixed-space.ts && bun examples/knapsack.ts && bun examples/tsp.ts && bun examples/custom-brick.ts",
		"format": "bunx --bun @biomejs/biome format --write ./src",
		"check": "bunx --bun @biomejs/biome check ./src",
		"lint": "bunx --bun @biomejs/biome lint ./src",
		"lint:write": "bunx --bun @biomejs/biome lint --write ./src",
		"test": "bun test",
		"build": "tsc --project tsconfig.json",
		"docs": "typedoc",
		"deploy:npm": "npm publish --access public",
		"publish-package": "bash ./scripts/publish-package.sh"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@eslint/js": "^10.0.1",
		"@types/bun": "^1.4.4",
		"eslint": "^10.14.0",
		"globals": "^17.14.0",
		"jiti": "^2.7.0",
		"tsup": "^9.0.0",
		"typedoc": "^0.28.20",
		"typescript-eslint": "^8.72.1"
	},
	"peerDependencies": {
		"typescript": "^7.0.2"
	}
}
